// Google Apps Script backend for Cacao Corner. Set SHEET_ID and ADMIN_TOKEN before deploying.
const SHEET_ID='PUT_GOOGLE_SHEET_ID_HERE';
const ADMIN_TOKEN='CHANGE_ME_TO_A_LONG_RANDOM_TOKEN';
function ss_(){return SpreadsheetApp.openById(SHEET_ID)}
function init(){const s=ss_();['Orders','Order_Items'].forEach(n=>{let sh=s.getSheetByName(n)||s.insertSheet(n);if(sh.getLastRow()===0)sh.appendRow(n==='Orders'?['Order ID','Created At','Name','Phone','Address','Note','Total','Status']:['Order ID','SKU','Product','Unit Price','Quantity','Subtotal'])});}
function doPost(e){try{init();let payload=JSON.parse(e.postData.contents);if(payload.action!=='createOrder')return json_({ok:false,error:'Unsupported action'});let o=payload.order;if(!o||!o.name||!o.phone||!o.address||!o.items||!o.items.length)throw Error('Missing fields');let id='CC-'+Utilities.formatDate(new Date(),'Asia/Bangkok','yyyyMMdd-HHmmss')+'-'+Math.floor(Math.random()*900+100);let lock=LockService.getScriptLock();lock.waitLock(10000);try{let s=ss_(),orders=s.getSheetByName('Orders'),items=s.getSheetByName('Order_Items');orders.appendRow([id,new Date(),safe_(o.name),safe_(o.phone),safe_(o.address),safe_(o.note||''),Number(o.total)||0,'New']);o.items.forEach(i=>items.appendRow([id,safe_(i.sku),safe_(i.name),Number(i.price)||0,Number(i.quantity)||0,(Number(i.price)||0)*(Number(i.quantity)||0)]));}finally{lock.releaseLock()}return json_({ok:true,orderId:id})}catch(err){return json_({ok:false,error:String(err)})}}
function doGet(e){try{if(e.parameter.action!=='listOrders')return json_({ok:true,message:'Cacao API ready'});if(e.parameter.token!==ADMIN_TOKEN)return json_({ok:false,error:'Unauthorized'});init();let s=ss_(),a=s.getSheetByName('Orders').getDataRange().getValues(),b=s.getSheetByName('Order_Items').getDataRange().getValues(),orders=[];for(let r=1;r<a.length;r++){let items=b.slice(1).filter(x=>x[0]===a[r][0]).map(x=>({sku:x[1],name:x[2],price:x[3],quantity:x[4]}));orders.push({orderId:a[r][0],createdAt:a[r][1],name:a[r][2],phone:a[r][3],address:a[r][4],note:a[r][5],total:a[r][6],status:a[r][7],items})}return json_({ok:true,orders})}catch(err){return json_({ok:false,error:String(err)})}}
function safe_(v){v=String(v||'');return v.replace(/^[=+\-@]/,'\u0027$&')}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
